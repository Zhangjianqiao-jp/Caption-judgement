{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caption evaluation provenance",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "track", "protocol", "dataset", "code_commit", "models", "generation", "evaluator", "source_generations_sha256", "dataset_manifest_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "track": {"enum": ["homer_comparable", "project_extension"]},
    "protocol": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "code_commit": {"type": "string", "minLength": 1},
    "source_generations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "models": {"type": "array", "minItems": 1},
    "generation": {"type": "object"},
    "evaluator": {"type": "object"},
    "protocol_details": {"type": "object"}
  },
  "additionalProperties": true
}
